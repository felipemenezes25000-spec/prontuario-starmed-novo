# Copy to .env at repository root. NEVER commit the real file.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://starmed:change_me@localhost:5432/starmed
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_ISSUER=starmed-local
AUTH_AUDIENCE=starmed-api
# Uma ou mais origens EXATAS separadas por vírgula (nunca "*"). Local: as duas
# formas do endereço, senão o navegador bloqueia o login por CORS.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Opcional, SÓ desenvolvimento local (arquivo .env.local, gitignorado): pré-preenche
# o login no `vite dev`. Nunca entra no build de produção.
# VITE_DEV_LOGIN_EMAIL=admin@starmed.local.invalid
# VITE_DEV_LOGIN_PASSWORD=<senha do BOOTSTRAP_ADMIN_PASSWORD>
API_PORT=3001
VITE_API_URL=http://localhost:3001
# Optional, disabled unless org ai_enabled=true and credentials provided:
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
BOOTSTRAP_ORGANIZATION=StarMed Demonstracao
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Smoke E2E — SOMENTE banco descartável, nunca ambiente com dados reais.
# O CI preenche estes valores com credenciais sintéticas exclusivas do run.
STARMED_TEST_DB=false
STARMED_SMOKE_API_URL=http://127.0.0.1:3001
STARMED_SMOKE_ADMIN_EMAIL=
STARMED_SMOKE_ADMIN_PASSWORD=
# Rate limit distribuído (tabela rate_limits, migração 021): por rota/IP, em Postgres.
# TRUST_PROXY=true SOMENTE atrás de proxy reverso real (X-Forwarded-For confiável).
TRUST_PROXY=false
# Revogação OCSP: off (padrão, sem rede) | soft (reporta) | hard (bloqueia revoked/unknown).
REVOCATION_MODE=off
# Optional OIDC SSO (disabled unless OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_REDIRECT_URI are set):
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_CLIENT_AUTH=basic
SSO_WEB_CALLBACK=
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=reception

# ---------------------------------------------------------------------------
# Integrações — TODAS nascem DESLIGADAS: sem o env do canal não há rede.
# Cada canal aceita *_SANDBOX='true' (simulação sem rede, resposta honesta).
# ---------------------------------------------------------------------------
# ACT/TSA (carimbo de tempo PAdES; capacidade nasce desligada sem TSA_URL):
TSA_URL=
TSA_TOKEN_URL=
TSA_CONSUMER_KEY=
TSA_CONSUMER_SECRET=
# Hospitalar LIS/PACS (Fase 3 — fila integration_outbox + DLQ + circuit breaker):
LIS_URL=
LIS_SANDBOX=false
PACS_URL=
PACS_SANDBOX=false
# HL7 v2 sobre MLLP+TLS (Fase 6 — CA OBRIGATÓRIA quando TLS=true, padrão true):
HL7_MLLP_HOST=
HL7_MLLP_PORT=2575
HL7_MLLP_TLS=true
HL7_MLLP_CA=
HL7_MLLP_CLIENT_CERT=
HL7_MLLP_CLIENT_KEY=
HL7_MLLP_SANDBOX=false
# Lotes TISS, NFSe (ABRASF) e submissão RNDS (Fase 6):
TISS_LOTE_URL=
TISS_SANDBOX=false
NFSE_URL=
NFSE_SANDBOX=false
RNDS_SUBMIT_URL=
RNDS_SANDBOX=false
# DICOMweb (Fase 6 — sandbox devolve matches vazio honesto, nunca exame inventado):
DICOMWEB_URL=
DICOMWEB_AETITLE=
DICOMWEB_SANDBOX=false
# CRM/WhatsApp do portal (fila crm_outbox; sem URL o envio fica 'queued'):
CRM_PROVIDER_URL=
# Teleconsulta ICE/TURN (JSON array; sem env → P2P direto, sem credencial):
TELECONSULT_ICE_SERVERS=
# Validador FHIR oficial (scripts/rnds/validate-official.mjs; --jar > este env > cache):
FHIR_VALIDATOR_JAR=

# Receita de antimicrobiano (RDC 471/2021) — DESLIGADA por padrão; ver ADR-0005.
# Controle especial (Portaria 344) permanece bloqueado até integração SNCR homologada.
# FEATURE_ANTIMICROBIAL_RX=on
