# Copy to .env at repository root. NEVER commit the real file.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://starmed:change_me@localhost:5432/starmed
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_ISSUER=starmed-local
AUTH_AUDIENCE=starmed-api
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
VITE_API_URL=http://localhost:3001
# Optional, disabled unless org ai_enabled=true and credentials provided:
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
BOOTSTRAP_ORGANIZATION=StarMed Demonstracao
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Smoke E2E — SOMENTE banco descartável, nunca ambiente com dados reais.
# O CI preenche estes valores com credenciais sintéticas exclusivas do run.
STARMED_TEST_DB=false
STARMED_SMOKE_API_URL=http://127.0.0.1:3001
STARMED_SMOKE_ADMIN_EMAIL=
STARMED_SMOKE_ADMIN_PASSWORD=
# Rate limit distribuído (tabela rate_limits, migração 021): por rota/IP, em Postgres.
# TRUST_PROXY=true SOMENTE atrás de proxy reverso real (X-Forwarded-For confiável).
TRUST_PROXY=false
# Revogação OCSP: off (padrão, sem rede) | soft (reporta) | hard (bloqueia revoked/unknown).
REVOCATION_MODE=off
# Optional OIDC SSO (disabled unless OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_REDIRECT_URI are set):
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_CLIENT_AUTH=basic
SSO_WEB_CALLBACK=
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=reception
